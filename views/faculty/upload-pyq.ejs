<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upload PYQ — SOET Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
  <style>
    :root { --blue:#003399; --purple:#7b1fa2; }
    body { background:#f0f4ff; font-family:'Segoe UI',sans-serif; }
    .upload-card {
      background:white; border-radius:20px; padding:32px;
      box-shadow:0 4px 20px rgba(0,0,0,0.08);
      max-width:700px; margin:0 auto;
    }
    .form-label { font-weight:600; font-size:0.85rem; color:#555; }
    .form-control, .form-select {
      border-radius:10px; border-color:#e0e7ff;
      padding:10px 14px; font-size:0.9rem;
    }
    .form-control:focus, .form-select:focus {
      border-color:var(--purple);
      box-shadow:0 0 0 3px rgba(123,31,162,0.12);
    }
    .btn-submit {
      background:linear-gradient(135deg,var(--purple),#9c27b0);
      color:white; border:none; border-radius:12px;
      padding:13px 30px; font-weight:700; font-size:1rem;
      width:100%; cursor:pointer; transition:all 0.3s;
    }
    .btn-submit:hover { background:linear-gradient(135deg,#6a1b9a,#7b1fa2); transform:translateY(-1px); }
    .drop-zone {
      border:2px dashed #ce93d8; border-radius:14px;
      padding:36px 20px; text-align:center;
      cursor:pointer; transition:all 0.2s; background:#fdf6ff;
    }
    .drop-zone:hover { border-color:var(--purple); background:#f3e5f5; }
    .drop-zone.has-file { border-color:#2e7d32; background:#f1f8e9; }
    .type-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; }
    .type-btn {
      border:2px solid #e0e7ff; border-radius:12px;
      padding:16px 10px; text-align:center; cursor:pointer;
      transition:all 0.2s; background:white; user-select:none;
    }
    .type-btn:hover { border-color:var(--purple); background:#f3e5f5; }
    .type-btn.selected { background:var(--purple); border-color:var(--purple); }
    .type-btn.selected .type-label { color:white; }
    .type-btn.selected .type-sub { color:rgba(255,255,255,0.8); }
    .type-label { font-weight:700; font-size:0.95rem; color:#555; }
    .type-sub { font-size:0.75rem; color:#aaa; margin-top:4px; }
    .alert-msg {
      padding:10px 16px; border-radius:10px;
      margin-bottom:16px; font-size:0.88rem; display:none;
    }
    .alert-msg.show { display:block; }
    .alert-success-msg { background:#e8f5e9; color:#2e7d32; border:1px solid #c8e6c9; }
    .alert-error-msg { background:#fce4ec; color:#c62828; border:1px solid #f8bbd0; }
  </style>
</head>
<body>

<%- include('../partials/facultyNavbar') %>

<div class="container-fluid px-3 px-md-4 py-4">
  <div class="upload-card">

    <div class="d-flex align-items-center gap-3 mb-4">
      <div style="width:52px;height:52px;background:#f3e5f5;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;color:var(--purple);">
        <i class="bi bi-file-earmark-plus-fill"></i>
      </div>
      <div>
        <h4 class="fw-bold mb-0">Upload Previous Year Paper</h4>
        <div class="text-muted" style="font-size:0.83rem;">PDF files only · Max 20MB</div>
      </div>
    </div>

    <% if (success) { %>
      <div class="alert-msg alert-success-msg show">
        <i class="bi bi-check-circle-fill me-2"></i><%= success %>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="alert-msg alert-error-msg show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
      </div>
    <% } %>

    <div id="jsAlert" class="alert-msg"></div>

    <form action="/faculty/pyq/upload" method="POST" enctype="multipart/form-data" id="pyqForm">

      <!-- Subject -->
      <div class="mb-4">
        <label class="form-label">Subject <span class="text-danger">*</span></label>
        <select name="subjectCode" id="subjectSelect" class="form-select" required>
          <option value="">— Select Subject —</option>
          <% subjectOptions.forEach(s => { %>
            <option value="<%= s.subjectCode %>">
              [Sem <%= s.semester %>] <%= s.subjectCode %> — <%= s.name %>
            </option>
          <% }); %>
        </select>
      </div>

      <!-- Exam Type -->
      <div class="mb-4">
        <label class="form-label d-block">Exam Type <span class="text-danger">*</span></label>
        <div class="type-grid">
          <div class="type-btn" id="btn-midterm" onclick="selectType('MidTerm', this)">
            <div class="type-label">📝 Mid-Term</div>
            <div class="type-sub">Mid Semester Examination</div>
          </div>
          <div class="type-btn" id="btn-endterm" onclick="selectType('EndTerm', this)">
            <div class="type-label">📋 End-Term</div>
            <div class="type-sub">End Semester Examination</div>
          </div>
        </div>
        <input type="hidden" name="examType" id="examTypeInput">
      </div>

      <!-- Year + Semester Type -->
      <div class="row g-3 mb-4">
        <div class="col-6">
          <label class="form-label">Year <span class="text-danger">*</span></label>
          <select name="year" class="form-select" required>
            <option value="">— Select Year —</option>
            <% years.forEach(y => { %>
              <option value="<%= y %>"><%= y %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-6">
          <label class="form-label">Semester Type <span class="text-danger">*</span></label>
          <select name="semesterType" class="form-select" required>
            <option value="">— Select —</option>
            <option value="odd">Odd (Jul–Nov)</option>
            <option value="even">Even (Jan–Jun)</option>
          </select>
        </div>
      </div>

      <!-- File Upload -->
      <div class="mb-4">
        <label class="form-label">PDF File <span class="text-danger">*</span></label>
        <div class="drop-zone" id="dropZone" onclick="document.getElementById('fileInput').click()">
          <i class="bi bi-file-earmark-pdf fs-1 mb-2 d-block" style="color:#ce93d8;" id="dropIcon"></i>
          <div class="fw-semibold" style="color:#666;" id="dropText">Click to browse or drag & drop PDF</div>
          <div style="color:#aaa;font-size:0.78rem;margin-top:4px;" id="dropSub">Maximum 20MB · PDF only</div>
        </div>
        <input type="file" name="file" id="fileInput" accept=".pdf,application/pdf"
          class="d-none" onchange="handleFileSelect(this)">
        <div id="fileMsg" style="font-size:0.78rem;margin-top:6px;"></div>
      </div>

      <button type="button" class="btn-submit" onclick="submitPYQ()">
        <i class="bi bi-cloud-upload me-2"></i>Upload PYQ
      </button>

    </form>

    <div class="mt-3 text-center">
      <a href="/faculty/dashboard" class="text-muted" style="font-size:0.85rem;">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
      </a>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>

  // ── Select2 ──
  $(document).ready(function() {
    $('#subjectSelect').select2({
      placeholder: '— Search or select subject —',
      allowClear: true,
      width: '100%'
    });
    var urlParams = new URLSearchParams(window.location.search);
    var subjectParam = urlParams.get('subject');
    if (subjectParam) {
      $('#subjectSelect').val(subjectParam).trigger('change');
    }
  });

  // ── Exam type ──
  function selectType(type, el) {
    document.querySelectorAll('.type-btn').forEach(function(b) {
      b.classList.remove('selected');
    });
    el.classList.add('selected');
    document.getElementById('examTypeInput').value = type;
  }

  // ── File select ──
  function handleFileSelect(input) {
    var file = input.files[0];
    if (!file) return;
    var msgEl = document.getElementById('fileMsg');

    if (file.type !== 'application/pdf') {
      msgEl.textContent = 'Only PDF files are allowed.';
      msgEl.style.color = '#c62828';
      input.value = '';
      return;
    }
    if (file.size > 20 * 1024 * 1024) {
      msgEl.textContent = 'File too large. Maximum is 20MB.';
      msgEl.style.color = '#c62828';
      input.value = '';
      return;
    }

    var zone = document.getElementById('dropZone');
    zone.classList.add('has-file');
    document.getElementById('dropIcon').className = 'bi bi-file-earmark-check fs-1 mb-2 d-block';
    document.getElementById('dropIcon').style.color = '#2e7d32';
    document.getElementById('dropText').textContent = file.name;
    document.getElementById('dropSub').textContent = (file.size / 1024 / 1024).toFixed(2) + ' MB · PDF';
    msgEl.textContent = 'File ready to upload.';
    msgEl.style.color = '#2e7d32';
  }

  // ── Drag and drop ──
  var dz = document.getElementById('dropZone');
  dz.addEventListener('dragover', function(e) {
    e.preventDefault();
    dz.style.borderColor = '#7b1fa2';
    dz.style.background = '#f3e5f5';
  });
  dz.addEventListener('dragleave', function() {
    dz.style.borderColor = '#ce93d8';
    dz.style.background = '#fdf6ff';
  });
  dz.addEventListener('drop', function(e) {
    e.preventDefault();
    dz.style.borderColor = '#ce93d8';
    dz.style.background = '#fdf6ff';
    var file = e.dataTransfer.files[0];
    if (file) {
      var input = document.getElementById('fileInput');
      var dt = new DataTransfer();
      dt.items.add(file);
      input.files = dt.files;
      handleFileSelect(input);
    }
  });

  // ── Show alert ──
  function showAlert(msg, type) {
    var el = document.getElementById('jsAlert');
    el.textContent = msg;
    el.className = 'alert-msg show ' + (type === 'error' ? 'alert-error-msg' : 'alert-success-msg');
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  // ── Submit ──
  function submitPYQ() {
    var subject = $('#subjectSelect').val();
    var examType = document.getElementById('examTypeInput').value;
    var year = document.querySelector('select[name="year"]').value;
    var semType = document.querySelector('select[name="semesterType"]').value;
    var file = document.getElementById('fileInput').files[0];

    if (!subject) { showAlert('Please select a subject.', 'error'); return; }
    if (!examType) { showAlert('Please select an exam type (Mid-Term or End-Term).', 'error'); return; }
    if (!year) { showAlert('Please select a year.', 'error'); return; }
    if (!semType) { showAlert('Please select semester type (odd/even).', 'error'); return; }
    if (!file) { showAlert('Please select a PDF file to upload.', 'error'); return; }

    document.getElementById('pyqForm').submit();
  }

</script>
</body>
</html>