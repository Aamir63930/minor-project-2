<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Post Announcement — SOET Portal</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/main.css" rel="stylesheet">
  <style>
    body { background:#f0f4ff; font-family:'Segoe UI',sans-serif; }
    .form-card {
      background:white; border-radius:20px; padding:32px;
      box-shadow:0 4px 20px rgba(0,0,0,0.08);
      max-width:680px; margin:0 auto;
    }
    .form-label { font-weight:600; font-size:0.85rem; color:#555; }
    .form-control, .form-select {
      border-radius:10px; border-color:#e0e7ff;
      padding:10px 14px; font-size:0.9rem;
    }
    .form-control:focus, .form-select:focus {
      border-color:#003399;
      box-shadow:0 0 0 3px rgba(0,51,153,0.12);
    }
    .cat-option {
      border:2px solid #e0e7ff; border-radius:10px;
      padding:10px 14px; cursor:pointer; transition:all 0.15s;
      text-align:center; font-weight:600; font-size:0.82rem; color:#666;
      user-select:none;
    }
    .cat-option:hover { border-color:#003399; }
    .cat-option.selected { border-color:#003399; background:#eef2ff; color:#003399; }
    .cat-option.sel-Exam { border-color:#c62828; background:#fce4ec; color:#c62828; }
    .cat-option.sel-Urgent { border-color:#b71c1c; background:#ffebee; color:#b71c1c; }
    .cat-option.sel-Holiday { border-color:#2e7d32; background:#e8f5e9; color:#2e7d32; }
    .cat-option.sel-Result { border-color:#7b1fa2; background:#f3e5f5; color:#7b1fa2; }
    .cat-option.sel-Assignment { border-color:#e65100; background:#fff3e0; color:#e65100; }
    .scope-option {
      border:2px solid #e0e7ff; border-radius:10px;
      padding:12px 16px; cursor:pointer; transition:all 0.15s;
      font-size:0.85rem; color:#666;
    }
    .scope-option:hover { border-color:#003399; }
    .scope-option.selected { border-color:#003399; background:#eef2ff; color:#003399; }
    .scope-option .s-title { font-weight:700; font-size:0.88rem; }
    .scope-option .s-sub { font-size:0.72rem; margin-top:2px; opacity:0.7; }
    .btn-post {
      background:linear-gradient(135deg,#003399,#0055cc);
      color:white; border:none; border-radius:12px;
      padding:13px 30px; font-weight:700; font-size:1rem;
      width:100%; cursor:pointer; transition:all 0.3s;
    }
    .btn-post:hover { transform:translateY(-1px); }
    .char-count { font-size:0.72rem; color:#aaa; }
  </style>
</head>
<body data-authenticated="true">

<%- include('../partials/facultyNavbar') %>

<div class="container-fluid px-3 px-md-4 py-4">
  <div class="form-card">

    <div class="d-flex align-items-center gap-3 mb-4">
      <div style="width:52px;height:52px;background:#fff3e0;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:1.5rem;color:#e65100;">
        <i class="bi bi-megaphone-fill"></i>
      </div>
      <div>
        <h4 class="fw-bold mb-0">Post Announcement</h4>
        <div class="text-muted" style="font-size:0.82rem;">Notify students about important updates</div>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger d-flex gap-2 align-items-start mb-4" style="border-radius:12px;">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i><span><%= error %></span>
      </div>
    <% } %>

    <form action="/announcements" method="POST" id="annForm">

      <!-- Title -->
      <div class="mb-4">
        <label class="form-label">Title <span class="text-danger">*</span></label>
        <input type="text" name="title" class="form-control" maxlength="200" required
          placeholder="e.g. Mid-Term Exam Schedule — Semester 4"
          oninput="document.getElementById('titleCount').textContent = this.value.length">
        <div class="d-flex justify-content-end mt-1">
          <span class="char-count"><span id="titleCount">0</span>/200</span>
        </div>
      </div>

      <!-- Content -->
      <div class="mb-4">
        <label class="form-label">Content <span class="text-danger">*</span></label>
        <textarea name="content" class="form-control" rows="5" maxlength="2000" required
          placeholder="Write your announcement here..."
          oninput="document.getElementById('contentCount').textContent = this.value.length"></textarea>
        <div class="d-flex justify-content-end mt-1">
          <span class="char-count"><span id="contentCount">0</span>/2000</span>
        </div>
      </div>

      <!-- Category -->
      <div class="mb-4">
        <label class="form-label d-block">Category <span class="text-danger">*</span></label>
        <div class="row g-2">
          <% ['General','Exam','Holiday','Urgent','Assignment','Result'].forEach(function(cat) { %>
            <div class="col-4 col-md-2">
              <div class="cat-option" onclick="selectCat('<%= cat %>', this)">
                <%= cat === 'General' ? '📢' : cat === 'Exam' ? '📝' : cat === 'Holiday' ? '🎉' : cat === 'Urgent' ? '🚨' : cat === 'Assignment' ? '📋' : '🏆' %>
                <div style="margin-top:4px;"><%= cat %></div>
              </div>
            </div>
          <% }); %>
        </div>
        <input type="hidden" name="category" id="categoryInput" value="General">
      </div>

      <!-- Scope -->
      <div class="mb-4">
        <label class="form-label d-block">Who should see this? <span class="text-danger">*</span></label>
        <div class="row g-2">
          <div class="col-12 col-md-4">
            <div class="scope-option selected" onclick="selectScope('college-wide', this)" id="scope-college-wide">
              <div class="s-title">🏫 College-wide</div>
              <div class="s-sub">All students see this</div>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <div class="scope-option" onclick="selectScope('course-specific', this)" id="scope-course-specific">
              <div class="s-title">📚 Specific Course</div>
              <div class="s-sub">Select which courses</div>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <div class="scope-option" onclick="selectScope('semester-specific', this)" id="scope-semester-specific">
              <div class="s-title">📅 Specific Semester</div>
              <div class="s-sub">Select course + semester</div>
            </div>
          </div>
        </div>
        <input type="hidden" name="scope" id="scopeInput" value="college-wide">
      </div>

      <!-- Target Courses (shown conditionally) -->
      <div id="courseSelector" class="mb-4" style="display:none;">
        <label class="form-label">Target Courses</label>
        <div class="row g-2">
          <% courses.forEach(function(course) { %>
            <div class="col-12 col-md-6">
              <div class="form-check" style="background:#f8f9ff;border-radius:10px;padding:10px 14px;border:0.5px solid #e0e7ff;">
                <input class="form-check-input" type="checkbox"
                  name="targetCourses" value="<%= course.courseCode %>"
                  id="course-<%= course.courseCode %>">
                <label class="form-check-label" for="course-<%= course.courseCode %>"
                  style="font-size:0.85rem;font-weight:600;color:#333;cursor:pointer;">
                  <%= course.shortName %> <span style="font-weight:400;color:#888;font-size:0.78rem;">(<%= course.courseCode %>)</span>
                </label>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- Target Semesters (shown conditionally) -->
      <div id="semesterSelector" class="mb-4" style="display:none;">
        <label class="form-label">Target Semesters</label>
        <div class="d-flex gap-2 flex-wrap">
          <% [1,2,3,4,5,6,7,8].forEach(function(sem) { %>
            <div>
              <input type="checkbox" name="targetSemesters" value="<%= sem %>"
                id="sem-<%= sem %>" class="d-none">
              <label for="sem-<%= sem %>"
                style="display:inline-block;border:2px solid #e0e7ff;border-radius:10px;padding:8px 16px;cursor:pointer;font-weight:700;font-size:0.85rem;color:#666;transition:all 0.15s;user-select:none;"
                onclick="toggleSemLabel(this)">
                Sem <%= sem %>
              </label>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- Options row -->
      <div class="row g-3 mb-4">
        <div class="col-12 col-md-6">
          <label class="form-label">Expiry Date <span class="text-muted">(optional)</span></label>
          <input type="date" name="expiresAt" class="form-control"
            min="<%= new Date().toISOString().split('T')[0] %>">
          <div class="text-muted mt-1" style="font-size:0.72rem;">Leave blank for no expiry</div>
        </div>
        <div class="col-12 col-md-6 d-flex align-items-end">
          <div class="form-check" style="background:#fff9e6;border-radius:10px;padding:14px 18px;border:1px solid #ffe082;width:100%;">
            <input class="form-check-input" type="checkbox" name="isPinned" id="isPinned">
            <label class="form-check-label fw-semibold" for="isPinned" style="cursor:pointer;">
              <i class="bi bi-pin-fill me-1" style="color:#FFB800;"></i>
              Pin this announcement
              <div style="font-size:0.72rem;color:#888;font-weight:400;">Pinned announcements stay at the top</div>
            </label>
          </div>
        </div>
      </div>

      <button type="button" class="btn-post" onclick="submitAnn()">
        <i class="bi bi-megaphone me-2"></i>Post Announcement
      </button>

    </form>

    <div class="mt-3 text-center">
      <a href="/announcements" class="text-muted" style="font-size:0.85rem;">
        <i class="bi bi-arrow-left me-1"></i>Back to Announcements
      </a>
    </div>

  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
  // Pre-select General category
  document.querySelector('.cat-option').classList.add('selected');

  function selectCat(cat, el) {
    document.querySelectorAll('.cat-option').forEach(function(b) {
      b.className = 'cat-option';
    });
    el.classList.add('selected');
    el.classList.add('sel-' + cat);
    document.getElementById('categoryInput').value = cat;
  }

  function selectScope(scope, el) {
    document.querySelectorAll('.scope-option').forEach(function(b) {
      b.classList.remove('selected');
    });
    el.classList.add('selected');
    document.getElementById('scopeInput').value = scope;
    document.getElementById('courseSelector').style.display =
      (scope === 'course-specific' || scope === 'semester-specific') ? 'block' : 'none';
    document.getElementById('semesterSelector').style.display =
      scope === 'semester-specific' ? 'block' : 'none';
  }

  function toggleSemLabel(label) {
    var input = document.getElementById(label.getAttribute('for'));
    if (input.checked) {
      label.style.background = '#003399';
      label.style.color = 'white';
      label.style.borderColor = '#003399';
    } else {
      label.style.background = 'white';
      label.style.color = '#666';
      label.style.borderColor = '#e0e7ff';
    }
  }

  function submitAnn() {
    var title = document.querySelector('input[name="title"]').value.trim();
    var content = document.querySelector('textarea[name="content"]').value.trim();
    if (!title) { alert('Please enter a title.'); return; }
    if (!content) { alert('Please enter the announcement content.'); return; }
    document.getElementById('annForm').submit();
  }
</script>
</body>
</html>