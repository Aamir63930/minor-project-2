<nav class="navbar navbar-expand-lg sticky-top" style="background: linear-gradient(90deg, #003399, #0055cc); box-shadow: 0 2px 15px rgba(0,51,153,0.3);">
  <div class="container-fluid px-4">

    <!-- Brand -->
    <a class="navbar-brand d-flex align-items-center gap-2 text-white" href="/student/dashboard">
      <i class="bi bi-mortarboard-fill fs-4" style="color:#FFB800;"></i>
      <span class="fw-bold" style="font-size:1rem;">SOET Portal</span>
    </a>

    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#studentNav">
      <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
    </button>

    <div class="collapse navbar-collapse" id="studentNav">
      <ul class="navbar-nav me-auto gap-1 ms-3">
        <li class="nav-item">
          <a class="nav-link text-white-50 d-flex align-items-center gap-1" href="/student/dashboard">
            <i class="bi bi-house-fill"></i> Dashboard
          </a>
        </li>
      </ul>

      <!-- Right side: user info + logout -->
      <div class="d-flex align-items-center gap-3">
        <div class="text-end d-none d-md-block">
          <div class="text-white fw-semibold" style="font-size:0.88rem; line-height:1.2;">
            <%= typeof student !== 'undefined' ? student.name : user.name %>
          </div>
          <div class="text-white-50" style="font-size:0.75rem;">
            <%= typeof student !== 'undefined' ? student.rollNo : user.rollNo %>
          </div>
        </div>
        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
          style="width:38px;height:38px;background:rgba(255,184,0,0.25);border:2px solid #FFB800;font-size:0.9rem;">
          <%= (typeof student !== 'undefined' ? student.name : user.name).charAt(0).toUpperCase() %>
        </div>

        <!-- Notification Bell -->
        <div class="position-relative me-1" id="notif-wrapper">
          <button id="notif-bell"
            style="background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);color:white;border-radius:10px;padding:7px 10px;cursor:pointer;position:relative;"
            onclick="toggleNotifDropdown()">
            <i class="bi bi-bell-fill" style="font-size:1rem;"></i>
            <span id="notif-badge"
              style="display:none;position:absolute;top:-6px;right:-6px;background:#ff4444;color:white;font-size:0.6rem;font-weight:700;padding:2px 5px;border-radius:10px;min-width:16px;text-align:center;line-height:1.4;">
              0
            </span>
          </button>

          <!-- Dropdown -->
          <div id="notif-dropdown"
            style="display:none;position:absolute;top:calc(100% + 10px);right:0;width:320px;background:white;border-radius:16px;box-shadow:0 8px 40px rgba(0,0,0,0.2);z-index:9999;overflow:hidden;">

            <!-- Dropdown Header -->
            <div style="padding:14px 18px;background:#003399;display:flex;align-items:center;justify-content:space-between;">
              <span style="color:white;font-weight:700;font-size:0.9rem;">
                <i class="bi bi-bell-fill me-2"></i>Notifications
              </span>
              <button id="mark-all-btn" onclick="markAllRead()"
                style="background:rgba(255,255,255,0.15);border:none;color:white;border-radius:6px;padding:3px 10px;font-size:0.72rem;cursor:pointer;font-weight:600;">
                Mark all read
              </button>
            </div>

            <!-- Notification Items -->
            <div id="notif-list" style="max-height:320px;overflow-y:auto;">
              <div style="text-align:center;padding:28px;color:#bbb;font-size:0.85rem;" id="notif-empty">
                <i class="bi bi-bell-slash" style="font-size:1.8rem;display:block;margin-bottom:8px;"></i>
                No notifications yet
              </div>
            </div>

            <!-- Footer -->
            <div style="padding:10px 18px;border-top:1px solid #f0f0f0;text-align:center;">
              <a href="/notifications"
                style="color:#003399;font-size:0.82rem;font-weight:600;text-decoration:none;">
                View all notifications <i class="bi bi-arrow-right ms-1"></i>
              </a>
            </div>
          </div>
        </div>

        <a href="/auth/logout" class="btn btn-sm d-flex align-items-center gap-1"
          style="background:rgba(255,255,255,0.12);color:#fff;border:1px solid rgba(255,255,255,0.25);border-radius:8px;">
          <i class="bi bi-box-arrow-right"></i>
          <span class="d-none d-md-inline">Logout</span>
        </a>
      </div>
    </div>
  </div>
</nav>